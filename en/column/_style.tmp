"    <style>\n    .column-hero {\n        background: linear-gradient(135deg, #001d30 0%, #003554 100%);\n        padding: 100px 20px 60px; color: #fff; text-align: center;\n    }\n    .column-hero h1 {\n        font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 800; line-height: 1.4;\n        max-width: 800px; margin: 0 auto 16px; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.3);\n    }\n    .column-breadcrumb { font-size: 0.85rem; color: rgba(255,255,255,0.85); margin-bottom: 20px; }\n    .column-breadcrumb a { color: rgba(255,255,255,0.95); text-decoration: none; }\n    .column-breadcrumb a:hover { text-decoration: underline; }\n    .column-body {\n        max-width: 820px; margin: 0 auto; padding: 48px 20px 80px;\n        font-size: 1rem; line-height: 1.85; color: #1e293b;\n    }\n    .column-body h2 {\n        font-size: 1.5rem; font-weight: 700; color: #003554;\n        margin: 56px 0 20px; padding-bottom: 10px; border-bottom: 3px solid #006494;\n    }\n    .column-body h3 { font-size: 1.2rem; font-weight: 700; color: #004a77; margin: 36px 0 14px; }\n    .column-body h4 { font-size: 1.05rem; font-weight: 700; color: #333; margin: 28px 0 10px; }\n    .column-body p { margin: 0 0 18px; }\n    .column-body strong { color: #003554; }\n    .column-body blockquote {\n        background: #f0f7ff; border-left: 4px solid #006494;\n        padding: 20px 24px; margin: 24px 0; border-radius: 0 8px 8px 0; font-size: 0.95rem;\n    }\n    .column-body blockquote p { margin: 0 0 8px; }\n    .column-body blockquote p:last-child { margin: 0; }\n    .column-body table {\n        width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.92rem;\n    }\n    .column-body table th {\n        background: #003554; color: #fff; padding: 12px 16px; text-align: left; font-weight: 600;\n    }\n    .column-body table td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }\n    .column-body table tr:nth-child(even) { background: #f8fafc; }\n    .column-body table tr:hover { background: #f0f7ff; }\n    .column-body ul, .column-body ol { margin: 0 0 18px 20px; }\n    .column-body li { margin: 0 0 8px; }\n    .column-body a { color: #006494; text-decoration: underline; }\n    .column-body a:hover { color: #003554; }\n    .column-body hr { border: none; border-top: 1px solid #e2e8f0; margin: 48px 0; }\n    .column-cta {\n        background: linear-gradient(135deg, #001d30, #003554); color: #fff;\n        padding: 48px 32px; border-radius: 16px; text-align: center; margin: 56px 0 32px;\n    }\n    .column-cta h3 { color: #fff; font-size: 1.4rem; margin: 0 0 16px; border: none; text-shadow: 0 2px 8px rgba(0,0,0,0.3); }\n    .column-cta p { color: #fff; margin: 0 0 24px; font-size: 1rem; text-shadow: 0 1px 4px rgba(0,0,0,0.2); }\n    .column-cta .cta-btn {\n        display: inline-block; background: #00880F; color: #fff;\n        padding: 16px 40px; border-radius: 8px; font-size: 1.1rem; font-weight: 700;\n        text-decoration: none; box-shadow: 0 4px 20px rgba(0,136,15,0.4); transition: all 0.3s;\n    }\n    .column-cta .cta-btn:hover { background: #006e0c; transform: translateY(-2px); color: #fff; }\n    .column-related {\n        margin: 48px 0 0; padding: 32px; background: #f4f7fa; border-radius: 12px;\n    }\n    .column-related h3 { color: #003554; font-size: 1.1rem; margin: 0 0 16px; border: none; }\n    .column-related ul { list-style: none; margin: 0; padding: 0; }\n    .column-related li { margin: 0 0 10px; }\n    .column-related a { color: #006494; text-decoration: none; font-size: 0.95rem; }\n    .column-related a:hover { text-decoration: underline; }\n    .column-related a::before { content: \"\\U0001F4D6 \"; }\n    @media (max-width: 768px) {\n        .column-hero { padding: 80px 16px 40px; }\n        .column-body { padding: 32px 16px 60px; }\n        .column-body h2 { font-size: 1.3rem; }\n        .column-body table { font-size: 0.82rem; }\n        .column-body table th, .column-body table td { padding: 8px 10px; }\n        .column-cta { padding: 32px 20px; }\n    }\n    </style>"